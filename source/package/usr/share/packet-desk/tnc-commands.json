  "guide": {
    "ABAUD": "Computer-side serial speed. A change may require a reset and a matching speed in Packet Desk.",
    "BEACON": "Controls automatic packet beacon timing on firmware with this command.",
    "BTEXT": "Sets the text that goes into beacon packets.",
    "COMMAND": "Sets the character that returns the TNC to command mode. Factory default is Ctrl+C.",
    "CONNECT": "Requests a packet link to a callsign. Add VIA and comma-separated callsigns for a digipeater path.",
    "CONVERS": "Treats keyboard input as packet text. Ctrl+C returns to the command prompt with factory settings.",
    "DISCONNE": "Ends the AX.25 link on the current TNC stream.",
    "DISPLAY": "Shows the TNC's current settings. Some firmware accepts a group selector.",
    "FRACK": "Sets the wait before an unacknowledged frame is retried.",
    "HBAUD": "Sets the over-the-air modem rate. The computer-side speed is controlled by ABAUD.",
    "HELP": "Lists the available firmware commands. HELP followed by a name gives a short explanation.",
    "INTFACE": "Selects the computer interface mode. Packet Desk uses TERMINAL mode.",
    "MAXFRAME": "Limits the number of outstanding packets before acknowledgment.",
    "MCON": "Controls monitoring while connected.",
    "MHEARD": "Displays the stations heard by the TNC.",
    "MONITOR": "Turns packet monitoring on or off. Other monitor settings control which packets appear.",
    "MYCALL": "Displays or sets your station callsign and optional SSID.",
    "PACLEN": "Controls the size of the packet data portion.",
    "RESET": "Restarts the TNC. This can drop active connections and apply pending interface changes.",
    "RESTORE": "Restores factory settings. Consult the manual before using it.",
    "RETRY": "Sets the retry limit for packet connections.",
    "STATUS": "Reports connection state on the TNC.",
    "STREAMSW": "Sets the character that introduces a stream selector in terminal mode.",
    "TXDELAY": "Sets the interval between keying the transmitter and sending packet data.",
    "UNPROTO": "Sets the destination and optional path for unconnected packet transmissions.",
    "VERSION": "Reports firmware version information.",
    "XFLOW": "Controls software flow control on the serial interface."
  }
}
